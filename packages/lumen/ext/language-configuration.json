{
  "comments": {
    "lineComment": "--",
    "blockComment": ["--[[", "]]"]
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["<", ">"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] },
    { "open": "<!--", "close": "-->", "notIn": ["comment", "string"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["<", ">"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "wordPattern": "(-?\\d*\\.\\d\\w*)|([^`~!@#%^&*()\\-=+\\[{\\]}\\\\|;:'\",.<>/?\\s]+)",
  "onEnterRules": [
    {
      "beforeText": "<([_:\\w][_:\\w\\-.\\d]*)(?:[^/>]*(?!/)>)[^<]*$",
      "afterText": "^<\\/([_:\\w][_:\\w\\-.\\d]*)\\s*>",
      "action": {
        "indent": "indentOutdent"
      }
    },
    {
      "beforeText": "<([_:\\w][_:\\w\\-.\\d]*)(?:[^/>]*(?!/)>)[^<]*$",
      "action": {
        "indent": "indent"
      }
    },
    {
      "beforeText": "^\\s*(?:function|local\\s+function|if|elseif|else|for|while|repeat|do)\\b(?!.*\\bend\\b).*$",
      "action": {
        "indent": "indent"
      }
    }
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?:(?:local\\s+)?function\\b.*|.*\\bthen\\s*$|.*\\bdo\\s*$|.*\\belse\\s*$|repeat\\s*$|.*\\{\\s*$|.*\\(\\s*$|\\s*<[A-Za-z_][\\w.\\-]*(?:\\s[^>]*)?(?<!/)>\\s*$)",
    "decreaseIndentPattern": "^\\s*(?:end\\b|else\\b|elseif\\b|until\\b|\\}|\\)|</[A-Za-z_][\\w.\\-]*\\s*>|/>)"
  },
  "folding": {
    "markers": {
      "start": "^\\s*--\\s*#?region\\b",
      "end": "^\\s*--\\s*#?endregion\\b"
    }
  }
}
