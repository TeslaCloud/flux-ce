--- The Commands page of the Help tab: every command the local player may run, grouped by
-- category, with its syntax, its description and its aliases.

local card_style = { padding = { 8, 12 }, gap = 2, background = 'surface_raised', radius = 6 }

--- One command.
-- @param props [Map command (Map as `Flux.Help:get_commands` lists them), prefix (String)]
local function Command(props)
  local command = props.command
  local dim = Lumen.Style.color('text_muted') or color_white

  return <view style={card_style}>
    <view style={{ direction = 'row', gap = 8, align = 'end' }}>
      <text style={{ font = 'text_normal', color = 'accent_light' }}>{props.prefix..command.name}</text>
      {command.syntax != '' and <text style={{ font = 'text_small', color = dim }}>{command.syntax}</text>}
    </view>
    {command.description != '' and <text style={{ font = 'text_smaller' }}>{command.description}</text>}
    {#command.aliases > 0 and <text style={{ font = 'text_smallest', color = dim }}>
      {t'ui.help.commands.aliases'..': '..table.concat(command.aliases, ', ')}
    </text>}
  </view>
end

return function(props)
  local prefix = Flux.Help:get_command_prefix()
  local categories = Flux.Help:get_commands()

  return <view style={{ gap = 8 }}>
    <text style={{ font = 'menu_large' }}>{t'ui.help.commands.title'}</text>
    {#categories == 0 and <view style={card_style}>
      <text style={{ font = 'text_normal' }}>{t'ui.help.commands.empty'}</text>
    </view>}
    {Lumen.map(categories, function(category)
      return <view key={category.name} style={{ gap = 4 }}>
        <text style={{ font = 'menu_normal', margin_top = 8, color = 'text_muted' }}>{category.name}</text>
        {Lumen.map(category.commands, function(command)
          return <Command key={command.id} command={command} prefix={prefix} />
        end)}
      </view>
    end)}
  </view>
end
