<? local prefix = Flux.HTML:escape(Flux.Help:get_command_prefix()) ?>
<? local categories = Flux.Help:get_commands() ?>
<div class="panel__title">
  <h1><?= Flux.HTML:escape(t'ui.help.commands.title') ?></h1>
</div>
<? if #categories == 0 then ?>
  <div class="content">
    <div class="command__card"><?= Flux.HTML:escape(t'ui.help.commands.empty') ?></div>
  </div>
<? end ?>
<? for k, category in ipairs(categories) do ?>
  <div class="panel__title">
    <h2><?= Flux.HTML:escape(category.name) ?></h2>
  </div>
  <div class="content">
    <? for k2, command in ipairs(category.commands) do ?>
      <div class="command__card">
        <div class="command__title">
          <span class="command__name"><?= prefix..Flux.HTML:escape(command.name) ?></span>
          <span class="command__syntax"><?= Flux.HTML:escape(command.syntax) ?></span>
        </div>
        <div class="command__description"><?= Flux.HTML:escape(command.description) ?></div>
        <? if #command.aliases > 0 then ?>
          <div class="command__aliases">
            <?= Flux.HTML:escape(t'ui.help.commands.aliases') ?>:
            <?= Flux.HTML:escape(table.concat(command.aliases, ', ')) ?>
          </div>
        <? end ?>
      </div>
    <? end ?>
  </div>
<? end ?>
