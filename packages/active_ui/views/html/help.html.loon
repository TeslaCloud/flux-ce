<? local pages = Flux.Help:get_pages() ?>
<div class="tab">
  <? for k, v in ipairs(pages) do ?>
    <button class="tab__links" onclick="openTab(event, 'help__<?= v.id ?>')">
      <?= Flux.HTML:escape(t(v.title)) ?>
    </button>
  <? end ?>
</div>

<? for k, v in ipairs(pages) do ?>
  <div id="help__<?= v.id ?>" class="tab__content">
    <?= Flux.Help:render_page(v) ?>
  </div>
<? end ?>
