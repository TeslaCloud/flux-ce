<div class="panel__title">
  <h1><?= Flux.HTML:escape(t'ui.help.plugins.schema') ?></h1>
</div>
<div class="content">
  <div class="plugin__card">
    <div class="plugin__title"><?= Flux.HTML:escape(SCHEMA:get_name()) ?></div>
    <div class="plugin__author"><?= Flux.HTML:escape(SCHEMA:get_author()) ?></div>
  </div>
</div>
<div class="panel__title">
  <h1><?= Flux.HTML:escape(t'ui.help.plugins.title') ?></h1>
</div>
<div class="content">
  <? for k, v in SortedPairsByMemberValue(Plugin.all(), 'author') do ?>
    <? if istable(v) and !v:is_schema() then ?>
      <div class="plugin__card">
        <div class="plugin__title"><?= Flux.HTML:escape(v.name) ?></div>
        <div class="plugin__author"><?= Flux.HTML:escape(v.author) ?></div>
        <div class="plugin__description"><?= Flux.HTML:escape(v.description) ?></div>
      </div>
    <? end ?>
  <? end ?>
</div>
